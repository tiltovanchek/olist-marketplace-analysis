	partition service_calendar = m
		mode: import
		source =
				let
				  Источник = Csv.Document(File.Contents(ProjectRoot & "\data\powerbi\service_calendar.csv"), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Повышенные заголовки" = Table.PromoteHeaders(Источник, [PromoteAllScalars = true]),
				  #"Измененный тип столбца" = Table.TransformColumnTypes(#"Повышенные заголовки", {{"date", type date}, {"month_start", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"year_month", type text}})
				in
				  #"Измененный тип столбца"

	annotation PBI_ResultType = Table
