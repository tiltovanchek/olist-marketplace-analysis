table service_orders
	lineageTag: b5623eb5-07f0-48cc-9051-9675a2d5e3f7

	measure 'Доставленные заказы сервиса' = COUNTROWS('service_orders')
		formatString: 0
		lineageTag: c67fbb24-23a9-4ae2-81dc-d5048deb6021

	measure 'Заказы с известной своевременностью' = COUNT(service_orders[is_late])
		formatString: 0
		lineageTag: 0857e5ce-25ad-4561-8b31-b98b47d48408

	measure 'Опоздавшие заказы' = sum(service_orders[is_late])
		formatString: 0
		lineageTag: c5d23403-24c9-44b2-9865-b5caa0ff75ae

	measure 'Доля опозданий' = divide([Опоздавшие заказы], [Заказы с известной своевременностью])
		lineageTag: d2d7bbf6-0bce-4428-9f85-934d72467071

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Заказы с отзывом' = COUNT('service_orders'[review_score])
		formatString: 0
		lineageTag: 1629076d-538a-4442-8e54-634ff14958eb

	measure 'Низкие оценки' = SUM(service_orders[is_low_score])
		formatString: 0
		lineageTag: 3c555a75-b1c9-4123-8a6b-e090cfd03e4d

	measure 'Доля низких оценок' = DIVIDE([Низкие оценки], [Заказы с отзывом])
		lineageTag: e51dd34c-acfb-43bc-a40a-1aaf4b193c45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Отзывы после доставки' = CALCULATE([Заказы с отзывом], service_orders[review_after_delivery] = 1)
		formatString: 0
		lineageTag: 466a9f26-d8c0-4bbd-aad6-75ba6d7ff6f9

	measure 'Доля низких оценок после доставки' = CALCULATE([Доля низких оценок], service_orders[review_after_delivery] = 1)
		lineageTag: f8ff4faa-7b1f-49d9-a33b-2bcce8b37f4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

