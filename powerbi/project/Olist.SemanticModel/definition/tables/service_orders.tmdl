	partition service_orders = m
		mode: import
		source =
				let
				  Источник = Csv.Document(File.Contents(ProjectRoot & "\data\powerbi\service_orders.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Повышенные заголовки" = Table.PromoteHeaders(Источник, [PromoteAllScalars = true]),
				  #"Изменены тип и локаль столбца." = Table.TransformColumnTypes(#"Повышенные заголовки", {{"delivery_days", type number}, {"order_id", type text}, {"purchase_date", type date}, {"customer_state", type text}, {"delivery_status", type text}, {"is_late", Int64.Type}, {"review_score", Int64.Type}, {"is_low_score", Int64.Type}, {"review_after_delivery", Int64.Type}}, "en-US")
				in
				  #"Изменены тип и локаль столбца."

	annotation PBI_ResultType = Table
